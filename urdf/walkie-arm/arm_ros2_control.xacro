<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="arm_ros2_control" params="name prefix hardware_type hardware_config_file">

    <xacro:property name="hw_config" value="${xacro.load_yaml(hardware_config_file)}"/>

    <!-- GLOBAL ISAAC MODE -->
    <xacro:if value="${hardware_type == 'isaac'}">
      <ros2_control name="${name}Isaac" type="system">
        <hardware>
          <plugin>topic_based_ros2_control/TopicBasedSystem</plugin>
          <param name="joint_commands_topic">/isaac_joint_commands</param>
          <param name="joint_states_topic">/isaac_joint_states</param>
        </hardware>
        <xacro:configure_joints_from_config prefix="${prefix}" target_type="isaac" id_offset="10" use_global_config="true"/>
      </ros2_control>
    </xacro:if>

    <!-- NORMAL CONFIG MODE (Mixed Real/Mock/Isaac based on yaml) -->
    <xacro:unless value="${hardware_type == 'isaac'}">
        <xacro:if value="${'cubemars' in hw_config['hardware_config'].values()}">
        <ros2_control name="${name}Real" type="system">
            <hardware>
            <plugin>cubemars_hardware/CubeMarsSystemHardware</plugin>
            <param name="can_interface">can0</param>
            </hardware>
            
            <xacro:configure_joints_from_config prefix="${prefix}" target_type="cubemars" id_offset="10" use_global_config="false"/>
        </ros2_control>
        </xacro:if>

        <xacro:if value="${'isaac' in hw_config['hardware_config'].values()}">
        <ros2_control name="${name}Isaac" type="system">
            <hardware>
            <plugin>topic_based_ros2_control/TopicBasedSystem</plugin>
            <param name="joint_commands_topic">/isaac_joint_commands</param>
            <param name="joint_states_topic">/isaac_joint_states</param>
            </hardware>
            <xacro:configure_joints_from_config prefix="${prefix}" target_type="isaac" id_offset="10" use_global_config="false"/>
        </ros2_control>
        </xacro:if>

        <ros2_control name="${name}Mock" type="system">
        <hardware>
            <plugin>mock_components/GenericSystem</plugin>
        </hardware>
        
        <xacro:configure_joints_from_config prefix="${prefix}" target_type="mock" id_offset="10" use_global_config="false"/>
        </ros2_control>
    </xacro:unless>

  </xacro:macro>

  <xacro:macro name="configure_joints_from_config" params="prefix target_type id_offset use_global_config">
    
    <xacro:if value="${use_global_config or hw_config['hardware_config'][prefix + '_joint1'] == target_type}">
      <xacro:configure_single_joint name="${prefix}_joint1" type="${target_type}" 
          can_id="${id_offset + 1}" gear_ratio="10.0" external_gear_ratio="10.0" pole_pairs="14" />
    </xacro:if>

    <xacro:if value="${use_global_config or hw_config['hardware_config'][prefix + '_joint2'] == target_type}">
      <xacro:configure_single_joint name="${prefix}_joint2" type="${target_type}" 
          can_id="${id_offset + 2}" gear_ratio="10.0" external_gear_ratio="10.0" pole_pairs="14" />
    </xacro:if>

    <xacro:if value="${use_global_config or hw_config['hardware_config'][prefix + '_joint3'] == target_type}">
      <xacro:configure_single_joint name="${prefix}_joint3" type="${target_type}" 
          can_id="${id_offset + 3}" gear_ratio="10.0" external_gear_ratio="10.0" pole_pairs="14" />
    </xacro:if>

    <xacro:if value="${use_global_config or hw_config['hardware_config'][prefix + '_joint4'] == target_type}">
      <xacro:configure_single_joint name="${prefix}_joint4" type="${target_type}" 
          can_id="${id_offset + 4}" gear_ratio="10.0" external_gear_ratio="10.0" pole_pairs="14" />
    </xacro:if>

    <xacro:if value="${use_global_config or hw_config['hardware_config'][prefix + '_joint5'] == target_type}">
      <xacro:configure_single_joint name="${prefix}_joint5" type="${target_type}" 
          can_id="${id_offset + 5}" gear_ratio="10.0" external_gear_ratio="1.0"  pole_pairs="14" />
    </xacro:if>

    <xacro:if value="${use_global_config or hw_config['hardware_config'][prefix + '_joint6'] == target_type}">
      <xacro:configure_single_joint name="${prefix}_joint6" type="${target_type}" 
          can_id="${id_offset + 6}" gear_ratio="10.0" external_gear_ratio="1.0"  pole_pairs="14" />
    </xacro:if>

    <xacro:if value="${use_global_config or hw_config['hardware_config'][prefix + '_joint7'] == target_type}">
      <xacro:configure_single_joint name="${prefix}_joint7" type="${target_type}" 
          can_id="${id_offset + 7}" gear_ratio="10.0" external_gear_ratio="1.0"  pole_pairs="14" />
    </xacro:if>

    <xacro:if value="${use_global_config or prefix + '_gripper_worm_gear_joint' in hw_config['hardware_config']}">
         <xacro:if value="${use_global_config or hw_config['hardware_config'][prefix + '_gripper_worm_gear_joint'] == target_type}">
            <xacro:configure_single_gripper name="${prefix}_gripper_worm_gear_joint" type="${target_type}" 
                can_id="${id_offset + 8}" gear_ratio="10.0" external_gear_ratio="1.0" />
         </xacro:if>
    </xacro:if>

  </xacro:macro>

  <xacro:macro name="configure_single_joint" params="name type can_id gear_ratio external_gear_ratio pole_pairs">
    <joint name="${name}">
      <xacro:if value="${type == 'cubemars'}">
        <param name="can_id">${can_id}</param>
        <param name="pole_pairs">${pole_pairs}</param>
        <param name="gear_ratio">${gear_ratio}</param>
        <param name="kt">0.123</param>
        <param name="enc_off">0.0</param>
        <param name="read_only">0</param>
        <param name="external_gear_ratio">${external_gear_ratio}</param>
      </xacro:if>
      
      <command_interface name="position"/>
      <command_interface name="velocity">
        <xacro:if value="${type == 'cubemars'}">
           <param name="min">-16</param> <param name="max">16</param>
        </xacro:if>
      </command_interface>
      <command_interface name="effort"/>
      
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
      <xacro:if value="${type == 'cubemars'}">
        <state_interface name="temperature"/>
      </xacro:if>
    </joint>
  </xacro:macro>

  <xacro:macro name="configure_single_gripper" params="name type can_id gear_ratio external_gear_ratio">
    <joint name="${name}">
      <xacro:if value="${type == 'cubemars'}">
         <param name="can_id">${can_id}</param>
         <param name="pole_pairs">14</param>
         <param name="gear_ratio">${gear_ratio}</param>
         <param name="kt">0.123</param>
         <param name="enc_off">0.0</param>
         <param name="read_only">0</param>
        <param name="external_gear_ratio">${external_gear_ratio}</param>
        <param name="trq_limit">1.7</param>
        <param name="grasp_detect">1</param>
      </xacro:if>

      <command_interface name="position"/>
      <command_interface name="effort"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
      <xacro:if value="${type == 'cubemars'}">
        <state_interface name="temperature"/>
      </xacro:if>
    </joint>
  </xacro:macro>
 
</robot>
