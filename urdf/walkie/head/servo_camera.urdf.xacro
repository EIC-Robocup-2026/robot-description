<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:include filename="$(find walkie_description)/urdf/walkie/depth_camera/zed/zed_macro.urdf.xacro"/>
  <xacro:macro name="servo_v0" params="prefix parent *joint_origin">
    <xacro:arg name="camera_name" default="zed_${prefix}"/>
    // <xacro:arg name="camera_name" default="zed"/>
    <xacro:arg name="camera_model" default="zed2i"/>
    <xacro:arg name="use_zed_localization" default="false"/>
    <!-- ============ Servo Mount ============ -->
    <joint name="${prefix}_servobase_joint" type="fixed">
      <xacro:insert_block name="joint_origin"/>
      <parent link="${parent}"/>
      <child link="${prefix}_servobase_link"/>
    </joint>
    <link name="${prefix}_servobase_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://walkie_description/meshes/walkie/ServoMountPlate.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="dark_grey">
          <color rgba="0.2 0.2 0.2 1"/>
        </material>
      </visual>
      <inertial>
        <mass value="0.05"/>
        <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/>
      </inertial>
    </link>
    <!-- ============ Servo Joint (tilt) ============ -->
    <joint name="${prefix}_servo_joint" type="revolute">
      <parent link="${prefix}_servobase_link"/>
      <child link="${prefix}_servo_link"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <axis xyz="-1 0 0"/>
      <limit lower="-0.384" upper="0.436" effort="10.0" velocity="1.0"/>
    </joint>
    <link name="${prefix}_servo_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://walkie_description/meshes/walkie/ServoCameraCase.stl" scale="0.001 0.001 0.001"/>
        </geometry>
      </visual>
      <collision>
        <origin xyz="0.104 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.208 0.039 0.039"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.2"/>
        <inertia ixx="1e-4" ixy="0" ixz="0" iyy="1e-4" iyz="0" izz="1e-4"/>
      </inertial>
    </link>
    <!-- ============ ZED Camera Body ============ -->
    <xacro:zed_camera name="$(arg camera_name)" model="$(arg camera_model)">
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </xacro:zed_camera>
    <!-- ============ Gazebo Sensors (Gz Sim / Jazzy) ============ -->
    <gazebo reference="$(arg camera_name)_camera_link">
      <!-- Left RGB Camera -->
      <sensor name="${prefix}_left_rgb_sensor" type="camera">
        <pose relative_to="$(arg camera_name)_left_camera_frame_optical">0 0 0 1.570796326794897 -1.570796326794897 0</pose>
        <camera name="${prefix}_left">
          <horizontal_fov>1.9199</horizontal_fov>
          <!-- ZED2i: 110 deg -->
          <image>
            <width>1920</width>
            <height>1080</height>
            <format>RGB_INT8</format>
          </image>
        </camera>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <visualize>true</visualize>
        <topic>${prefix}/rgb/image</topic>
        <gz_frame_id>$(arg camera_name)_left_camera_frame</gz_frame_id>
      </sensor>

      <!-- Left RGBD Camera -->
      <sensor name="${prefix}_rgbd_sensor" type="rgbd_camera">
        <pose relative_to="$(arg camera_name)_left_camera_frame_optical">0 0 0 1.570796326794897 -1.570796326794897 0</pose>
        <camera name="${prefix}_camera">
          <horizontal_fov>1.9199</horizontal_fov>
          <image>
            <width>640</width>
            <height>360</height>
            <format>RGB_INT8</format>
          </image>
          <clip>
            <near>0.3</near>
            <far>20</far>
          </clip>
          
          <depth_camera>
            <clip>
              <near>0.3</near>
              <far>20</far>
            </clip>
          </depth_camera>
        </camera>
        
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <visualize>true</visualize>
        
        <topic>${prefix}/rgbd</topic>
        
        <gz_frame_id>$(arg camera_name)_left_camera_frame</gz_frame_id>
      </sensor>
    </gazebo>
    <!-- ============ Camera Mounting Joint ============ -->
    <xacro:if value="$(arg use_zed_localization)">
      <joint name="$(arg camera_name)_joint" type="fixed">
        <parent link="$(arg camera_name)_camera_link"/>
        <child link="${prefix}_servo_link"/>
        <origin xyz="0.098 -0.02 -0.015" rpy="0 0 -1.5708"/>
      </joint>
    </xacro:if>
    <xacro:unless value="$(arg use_zed_localization)">
      <joint name="$(arg camera_name)_joint" type="fixed">
        <parent link="${prefix}_servo_link"/>
        <child link="$(arg camera_name)_camera_link"/>
        <origin xyz="0.098 -0.006 -0.015" rpy="0 0 -1.5708"/>
      </joint>
    </xacro:unless>
  </xacro:macro>
</robot>
