<?xml version="1.0" ?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:macro name="wheel_gazebo_v0" params="prefix">
	<gazebo reference="${prefix}_wheel_link">
	  <selfCollide>false</selfCollide>
      <mu1>1.0</mu1>
      <mu2>0.001</mu2>
      <fdir1>1 0 0</fdir1>
    </gazebo>
  </xacro:macro>
</robot>
